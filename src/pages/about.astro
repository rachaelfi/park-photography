---
import Base from '../layouts/Base.astro';
import CldImage from '../components/CldImage.astro';
import { ABOUT_FOLDER } from '../data/galleries';
import { firstInFolder } from '../lib/cloudinary-assets';
import { site } from '../data/site';

const portrait = await firstInFolder(
  ABOUT_FOLDER,
  `${site.photographer} photographed outdoors`,
);
---

<Base
  title="About"
  description={`About ${site.photographer}, a photographer working in ${site.baseLocation}.`}
>
  <section class="about">
    <div class="shell layout">
      <div class="portrait">
        {
          portrait && (
            <CldImage
              id={portrait.id}
              alt={portrait.alt}
              ratio={0.8}
              sizes="(min-width: 900px) 40vw, 100vw"
              gravity="face"
              loading="eager"
            />
          )
        }
      </div>

      <div class="bio">
        <h1>{site.photographer}</h1>
        <p class="lede">
          I've been photographing people outdoors for eight years, most of it within the beautiful landscapes of
          Utah.
        </p>
        <p class="muted">
          I started out shooting landscapes at five in the morning, which turned out to be
          good training for weddings: you learn to wait, and to work with whatever light
          you get. That's still how I shoot. I stay out of the way, I don't over-direct,
          and the pictures I like best are the ones nobody noticed me take.
        </p>
        <p class="muted">
          In between weddings there are family sessions, and couples who just
          want a decent picture together for once. I also do graduation and professional photoshoots.
        </p>
        <p class="muted">
          I live in {site.baseLocation} with my wife and golden retriever named Coco.
          I travel often and I'm happy to go further.
        </p>
        <a class="btn" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .layout { grid-template-columns: 0.85fr 1fr; }
    .portrait { position: sticky; top: 9rem; }
  }

  /* The Frame wrapper is gone, so the aspect ratio belongs here now. */
  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f2f2f0;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bio h1 { margin-bottom: 1rem; }
  .bio .lede { margin-bottom: 1.5rem; }
  .bio .btn { margin-top: 1rem; }
</style>