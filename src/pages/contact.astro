---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { galleries } from '../data/galleries';
---

<Base
  title="Contact"
  description={`Enquire about a session or wedding with ${site.photographer}.`}
>
  <section class="contact">
    <div class="shell narrow">
      <header class="centered">
        <h1>Contact</h1>
        <p class="lede muted">
          The fastest way to reach me is email. I answer every message within two
          business days.
        </p>
        <p class="address">
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="muted small">{site.phone} &nbsp;&middot;&nbsp; {site.baseLocation}</p>
      </header>

      <form id="contact-form" method="POST" action="/api/contact" novalidate>
        <div class="row">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="row">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="pair">
          <div class="row">
            <label for="kind">What for</label>
            <select id="kind" name="kind">
              {galleries.map((gallery) => <option value={gallery.title}>{gallery.title}</option>)}
              <option value="Something else">Something else</option>
            </select>
          </div>

          <div class="row">
            <label for="date">Date <span class="muted">(if you have one)</span></label>
            <input id="date" name="date" type="date" />
          </div>
        </div>

        <div class="row">
          <label for="message">Tell me about it</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <!-- Honeypot: real people leave this empty -->
        <div class="hp" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn" type="submit">Send message</button>

        <p class="status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact { padding-block: clamp(2.5rem, 6vw, 4.5rem); }

  header { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  header h1 { margin-bottom: 0.75rem; }

  .address {
    font-family: var(--serif);
    font-size: var(--step-1);
    margin: 1.5rem 0 0.35rem;
  }

  .small { font-size: var(--step--1); }

  form { display: grid; gap: 1.5rem; }

  .pair {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .pair { grid-template-columns: 1fr 1fr; }
  }

  .row { display: grid; gap: 0.45rem; }

  label {
    font-size: var(--step--1);
    letter-spacing: 0.03em;
  }

  input,
  select,
  textarea {
    font: inherit;
    font-size: var(--step-0);
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--hairline);
    border-radius: 0;
    padding: 0.6rem 0;
    width: 100%;
    transition: border-color 160ms ease;
  }

  input:focus,
  select:focus,
  textarea:focus { border-bottom-color: var(--evergreen); }

  textarea { resize: vertical; }

  .btn { justify-self: start; }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status {
    font-size: var(--step--1);
    margin: 0;
    min-height: 1.5em;
  }

  .status[data-state='error'] { color: #a2372f; }
  .status[data-state='ok'] { color: var(--evergreen); }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = form?.querySelector<HTMLElement>('[data-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    if (!form.checkValidity()) {
      status.dataset.state = 'error';
      status.textContent = 'Add your name, email and a message, then send again.';
      form.reportValidity();
      return;
    }

    button && (button.disabled = true);
    status.dataset.state = '';
    status.textContent = 'Sending…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });

      if (!response.ok) throw new Error(String(response.status));

      form.reset();
      status.dataset.state = 'ok';
      status.textContent = 'Message sent. I\u2019ll reply within two business days.';
    } catch {
      status.dataset.state = 'error';
      status.textContent =
        'That didn\u2019t send. Email hello@parkphotography.net directly and I\u2019ll pick it up there.';
    } finally {
      button && (button.disabled = false);
    }
  });
</script>
