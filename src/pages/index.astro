---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { loadGalleries, HERO_FOLDER } from '../data/galleries';
import { photosInFolder } from '../lib/cloudinary-assets';
import { site } from '../data/site';

const galleries = await loadGalleries();
const heroSlides = await photosInFolder(HERO_FOLDER, site.tagline);
---

<Base title="" description={site.tagline}>
  {heroSlides.length > 0 && <Hero slides={heroSlides} />}

  <section class="intro">
    <div class="shell narrow centered">
      <h1>{site.tagline}</h1>
      <p class="lede muted">
        I'm {site.photographer}, a photographer based in {site.baseLocation}. I shoot on
        film and digital, work in natural light, and leave people mostly alone so the
        pictures look like the day actually felt.
      </p>
      <a class="btn" href="/contact/">Check your date</a>
      <p class="note muted">{site.bookingNote}</p>
    </div>
  </section>

  <section class="work">
    <div class="shell">
      <h2 class="centered">The work</h2>
      <div class="grid">
        {galleries.map((gallery) => <GalleryCard gallery={gallery} showCount={false} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(3rem, 7vw, 5.5rem); }

  .intro h1 { margin-bottom: 1.25rem; }

  .intro .lede { margin-bottom: 2rem; }

  .note {
    font-size: var(--step--1);
    margin-top: 1.25rem;
  }

  .work {
    border-top: 1px solid var(--hairline);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  .work h2 { margin-bottom: clamp(2rem, 4vw, 3rem); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }
</style>