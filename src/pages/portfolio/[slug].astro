---
import Base from '../../layouts/Base.astro';
//import JustifiedGrid from '../../components/JustifiedGrid.astro';
import StaggeredGrid from '../../components/StaggeredGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { loadGalleries } from '../../data/galleries';
import { cldUrl } from '../../lib/cloudinary';

export async function getStaticPaths() {
  const galleries = await loadGalleries();

  return galleries.map((gallery, index) => ({
    params: { slug: gallery.slug },
    props: {
      gallery,
      next: galleries[(index + 1) % galleries.length],
    },
  }));
}

const { gallery, next } = Astro.props;
---

<Base
  title={gallery.title}
  description={gallery.blurb}
  ogImage={
    gallery.cover
      ? cldUrl(gallery.cover.id, { width: 1200, aspectRatio: '1.91' })
      : undefined
  }
>
  <section class="head">
    <div class="shell narrow centered">
      <h1>{gallery.title}</h1>
      <p class="lede muted">{gallery.intro}</p>
    </div>
  </section>

  {
    gallery.photos.length > 0 ? (
      <>
        <div class="shell">
          <StaggeredGrid photos={gallery.photos} />
        </div>

        <Lightbox photos={gallery.photos} />
      </>
    ) : (
      <div class="shell narrow centered">
        <p class="muted empty">Photographs from this collection are on their way.</p>
      </div>
    )
  }

  <nav class="onward shell centered" aria-label="Gallery">
    <a class="link" href="/portfolio/">All galleries</a>
    <a class="link next" href={`/portfolio/${next.slug}/`}>{next.title}</a>
  </nav>
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 3vw, 2.5rem); }
  .head h1 { margin-bottom: 0.75rem; }

  .empty { padding-block: clamp(2rem, 5vw, 3.5rem); }

  .onward {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem) 0;
    font-size: var(--step--1);
  }
</style>