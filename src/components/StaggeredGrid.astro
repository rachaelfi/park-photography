---
import CldImage from './CldImage.astro';
import type { Photo } from '../lib/cloudinary-assets';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="masonry">
  {
    photos.map((photo, index) => (
      <button
        class="cell"
        type="button"
        style={`aspect-ratio: ${photo.ratio};`}
        data-lightbox-index={index}
        aria-label={`Open ${photo.alt} full size`}
      >
        {/* No ratio passed here on purpose: a ratio asks Cloudinary to crop
            to that shape. The box already reserves the shape, so the image
            should arrive uncropped at its natural proportions. */}
        <CldImage
          id={photo.id}
          alt={photo.alt}
          sizes="(min-width: 1200px) 25vw, (min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"
          loading={index < 4 ? 'eager' : 'lazy'}
        />
      </button>
    ))
  }
</div>

<style>
  .masonry {
    /* --gap is the only spacing in play. Photos stack directly under one
       another within a column, so there is no row alignment to open up space
       around the shorter ones. */
    --gap: 10px;

    column-count: 1;
    column-gap: var(--gap);
    max-width: 1416px;
    margin-inline: auto;
  }

  @media (min-width: 600px) { .masonry { column-count: 2; } }
  @media (min-width: 900px) { .masonry { column-count: 3; } }
  @media (min-width: 1200px) { .masonry { column-count: 4; } }

  .cell {
    /* Keeps a photo from being split across a column break. */
    break-inside: avoid;
    -webkit-column-break-inside: avoid;

    display: block;
    width: 100%;
    margin: 0 0 var(--gap);
    padding: 0;
    border: 0;
    /* Shows through while the image decodes, so the reserved box reads as
       deliberate rather than as a hole in the layout. */
    background: #f2f2f0;
    cursor: zoom-in;
  }

  /* Fills the reserved box. When the reserved ratio matches the photo, which
     is always, contain and cover look identical. If the two ever disagree —
     stale data after a rename — contain shows a thin grey band instead of
     cutting part of the photo off. */
  .cell :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cell:focus-visible {
    outline: 2px solid var(--evergreen);
    outline-offset: 4px;
  }
</style>