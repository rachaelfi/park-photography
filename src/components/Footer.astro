---
import { site } from '../data/site';
const year = new Date().getFullYear();

/** Only the platforms you've filled in on site.ts are rendered. */
const socials = [
  { key: 'instagram', label: 'Instagram', href: site.instagram },
  { key: 'facebook', label: 'Facebook', href: site.facebook },
].filter((social) => Boolean(social.href));
---

<footer>
  <div class="shell inner">
    <p class="sign">{site.name}</p>

    {
      socials.length > 0 && (
        <ul class="socials">
          {socials.map((social) => (
            <li>
              <a href={social.href} rel="me noopener" target="_blank" aria-label={social.label}>
                {social.key === 'instagram' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle class="dot" cx="17.2" cy="6.8" r="1.15" />
                  </svg>
                )}
                {social.key === 'facebook' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M15.5 3.5h-2.2A4.3 4.3 0 0 0 9 7.8v2.4H6.8v3.2H9v7.1" />
                    <path d="M13.3 20.5v-7.1h2.6M9 13.4h4.3" />
                    <path d="M13.3 13.4V7.8c0-.6.5-1.1 1.1-1.1h1.1" />
                  </svg>
                )}
                {social.key === 'pinterest' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M10 21c.9-2 1.3-3.6 1.6-4.9l.9-3.8" />
                    <path d="M8.9 10.6c0-2.2 1.7-4 4-4s3.7 1.5 3.7 3.6c0 2.5-1.4 4.5-3.3 4.5-1 0-1.8-.8-1.6-1.8" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="meta muted">
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="sep" aria-hidden="true"></span>
      <span>{site.baseLocation}</span>
    </p>

    <p class="fine muted">&copy; {year} {site.photographer}. All photographs are the photographer's own work.</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hairline);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .inner { text-align: center; }

  .sign {
    font-family: var(--serif);
    font-size: var(--step-1);
    margin: 0 0 1.1rem;
  }

  .socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    color: var(--ink-soft);
    transition: color 160ms ease, border-color 160ms ease;
  }

  .socials a:hover,
  .socials a:focus-visible {
    color: var(--evergreen);
    border-color: var(--evergreen);
  }

  .socials svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .socials .dot {
    fill: currentColor;
    stroke: none;
  }

  .meta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: var(--step--1);
    margin: 0 0 1.25rem;
  }

  .sep {
    width: 14px;
    height: 1px;
    background: var(--hairline);
  }

  .fine {
    font-size: var(--step--1);
    margin: 0;
  }

  p { max-width: none; }
</style>