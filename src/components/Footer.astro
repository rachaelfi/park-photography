---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="shell inner">
    <p class="sign">{site.name}</p>
    <p class="meta muted">
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="sep" aria-hidden="true"></span>
      <a class="link" href={site.instagram} rel="me">Instagram</a>
      <span class="sep" aria-hidden="true"></span>
      <span>{site.baseLocation}</span>
    </p>
    <p class="fine muted">&copy; {year} {site.photographer}. All photographs are the photographer's own work.</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hairline);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .inner { text-align: center; }

  .sign {
    font-family: var(--serif);
    font-size: var(--step-1);
    margin: 0 0 0.75rem;
  }

  .meta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: var(--step--1);
    margin: 0 0 1.25rem;
  }

  .sep {
    width: 14px;
    height: 1px;
    background: var(--hairline);
  }

  .fine {
    font-size: var(--step--1);
    margin: 0;
  }

  p { max-width: none; }
</style>
