---
import { cldUrl } from '../lib/cloudinary';
import type { Photo } from '../data/galleries';

interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;

const items = photos.map((p) => ({
  src: cldUrl(p.id, { width: 2000, crop: 'limit' }),
  alt: p.alt,
}));
---

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <button class="close" type="button" data-lightbox-close aria-label="Close viewer">
    <span aria-hidden="true">&times;</span>
  </button>
  <button class="nav prev" type="button" data-lightbox-prev aria-label="Previous photo">
    <span aria-hidden="true">&#8249;</span>
  </button>
  <figure>
    <img data-lightbox-img src="" alt="" />
  </figure>
  <button class="nav next" type="button" data-lightbox-next aria-label="Next photo">
    <span aria-hidden="true">&#8250;</span>
  </button>
  <p class="count" data-lightbox-count aria-live="polite"></p>
</dialog>

<script is:inline define:vars={{ items }}>
  window.__lightboxItems = items;
</script>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const count = document.querySelector<HTMLElement>('[data-lightbox-count]');
  const items = (window as any).__lightboxItems as { src: string; alt: string }[];

  if (dialog && img && items?.length) {
    let index = 0;

    const render = () => {
      const item = items[index];
      img.src = item.src;
      img.alt = item.alt;
      if (count) count.textContent = `${index + 1} of ${items.length}`;
    };

    const open = (i: number) => {
      index = i;
      render();
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };

    const step = (delta: number) => {
      index = (index + delta + items.length) % items.length;
      render();
    };

    document.querySelectorAll('[data-lightbox-open]').forEach((el) => {
      el.addEventListener('click', () =>
        open(Number((el as HTMLElement).dataset.lightboxOpen)),
      );
    });

    document
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => dialog.close());
    document
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => step(-1));
    document
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => step(1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') step(1);
      if (event.key === 'ArrowLeft') step(-1);
    });

    // Click the backdrop to dismiss
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.985);
    color: var(--ink);
  }

  .lightbox::backdrop { background: rgba(255, 255, 255, 0.9); }

  .lightbox[open] {
    display: grid;
    grid-template-columns: 5rem 1fr 5rem;
    align-items: center;
  }

  figure {
    grid-column: 2;
    margin: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  figure img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .nav,
  .close {
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    line-height: 1;
    font-family: var(--sans);
  }

  .nav {
    font-size: 2.75rem;
    height: 100%;
    opacity: 0.55;
    transition: opacity 160ms ease;
  }
  .nav:hover { opacity: 1; }
  .prev { grid-column: 1; }
  .next { grid-column: 3; }

  .close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-size: 2rem;
    opacity: 0.55;
  }
  .close:hover { opacity: 1; }

  .count {
    position: absolute;
    bottom: 1.5rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 0;
    max-width: none;
  }

  @media (max-width: 700px) {
    .lightbox[open] { grid-template-columns: 3rem 1fr 3rem; }
    .nav { font-size: 2rem; }
  }
</style>
